{
  "manifest_version": 3,
  "name": "Vinted Chine Assist",
  "version": "1.0.0",
  "description": "Assistant de messages et négociation pour Vinted — modèles, réponses rapides et conseils (usage personnel).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vinted Chine Assist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
