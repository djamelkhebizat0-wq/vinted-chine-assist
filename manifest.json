{
  "manifest_version": 3,
  "name": "Vinted Chine Assist",
  "version": "1.2.0",
  "description": "Assistant vendeur Vinted (usage personnel) : négo locale, Mode auto optionnel, CRM, repost — sans cloud fictif.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vinted Chine Assist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.com/*"
      ],
      "js": ["lib/shared.js", "lib/nego.js", "lib/guard.js", "content.js", "content-auto.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
